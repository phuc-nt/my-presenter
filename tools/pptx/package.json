{
  "name": "my-presenter-pptx",
  "version": "0.1.0",
  "description": "Agent-first CLI: curated canonical JSON -> validated, previewed, editable PPTX. No browser, no Chromium.",
  "type": "module",
  "bin": { "mpg": "bin/mpg.js" },
  "files": ["bin", "src", "examples", "README.md", "AGENTS.md"],
  "scripts": {
    "test": "node --test 'test/*.test.js'",
    "example": "node bin/mpg.js build examples/minimal.json --out out/demo"
  },
  "engines": { "node": ">=20" },
  "dependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "commander": "^13.1.0",
    "jszip": "^3.10.2",
    "pptxgenjs": "^4.0.1",
    "zod": "^3.24.1"
  },
  "license": "MIT"
}
