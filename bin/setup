#!/usr/bin/env bash
# Installs the kit on this machine, without touching the network:
#   1. the secure HyperFrames bundle -> bundle/, its skills -> .claude/skills
#      (skills the kit owns are kept; the kit's own copy wins on a name clash);
#   2. the Node packages of tools/pptx, from vendor/npm-cache;
#   3. kit.config.json: narration by Gemini TTS, or none (silent video, subtitles only).
# Usage: bin/setup [--tts | --no-tts] [--no-video] [hyperframes-secure-<os>-<arch>.tar.gz]
#        default tarball: ../hyperframes-secure/out/, where that repo's build.sh writes it
set -euo pipefail
root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
os="$(uname -s | tr '[:upper:]' '[:lower:]')"
arch="$(uname -m)"
name="hyperframes-secure-$os-$arch"
tts="" video=1 tgz=""
for a in "$@"; do
  case "$a" in
    --tts) tts=gemini ;;
    --no-tts) tts=none ;;
    --no-video) video=0 ;;
    -h|--help) sed -n '2,9p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'; exit 0 ;;
    -*) echo "bin/setup: unknown option $a" >&2; exit 1 ;;
    *) tgz="$a" ;;
  esac
done
tgz="${tgz:-$root/../hyperframes-secure/out/$name.tar.gz}"
die() { echo "bin/setup: $*" >&2; exit 1; }
command -v node >/dev/null || die "Node.js 22 or newer is required"

# ---- 1. HyperFrames bundle and skills
if [ "$video" = 1 ]; then
  [ -f "$tgz" ] || die "no bundle at $tgz — pass its path, or use --no-video for slides only"
  tmp="$(mktemp -d "$root/.setup.XXXXXX")"
  trap 'rm -rf "$tmp"' EXIT
  tar -xzf "$tgz" -C "$tmp"
  [ -f "$tmp/$name/SHA256SUMS" ] || die "$tgz is not a $name bundle"
  ( cd "$tmp/$name" && shasum -a 256 -c SHA256SUMS > /dev/null ) || die "checksums of $tgz do not match"
  rm -rf "$root/bundle"
  mv "$tmp/$name" "$root/bundle"

  skills="$root/.claude/skills"
  list="$skills/.from-bundle"          # what the previous run installed
  mkdir -p "$skills"
  if [ -f "$list" ]; then
    while IFS= read -r n; do [ -n "$n" ] && rm -rf "${skills:?}/$n"; done < "$list"
  fi
  : > "$list"
  for src in "$root/bundle/kiro-skills"/*; do
    n="$(basename "$src")"
    if [ -e "$skills/$n" ]; then echo "  kept the kit's own $n"; continue; fi
    cp -R "$src" "$skills/$n"
    echo "$n" >> "$list"
  done
  echo "video: hyperframes $("$root/bundle/prefix/bin/hyperframes" --version), $(wc -l < "$list" | tr -d ' ') skills from $(basename "$tgz")"
else
  echo "video: skipped (--no-video)"
fi

# ---- 2. Node packages, from the cache in the repo
( cd "$root/tools/pptx" && npm ci --offline --cache "$root/vendor/npm-cache" --ignore-scripts --no-audit --no-fund --loglevel=error >/dev/null ) \
  || die "offline install of tools/pptx failed (vendor/npm-cache holds packages for darwin-arm64 only)"
rm -rf "$root/vendor/npm-cache/_logs" "$root/vendor/npm-cache/_update-notifier-last-checked"
echo "slides: tools/pptx packages installed from vendor/npm-cache"

# ---- 3. TTS choice
if [ -z "$tts" ]; then
  if [ -f "$root/kit.config.json" ]; then
    tts="$(sed -n 's/.*"tts"[[:space:]]*:[[:space:]]*"\([a-z]*\)".*/\1/p' "$root/kit.config.json" | head -1)"
  fi
  tts="${tts:-none}"
fi
printf '{\n  "tts": "%s"\n}\n' "$tts" > "$root/kit.config.json"
if [ "$tts" = gemini ]; then
  echo "tts: gemini — narration, music and the network to generativelanguage.googleapis.com are on"
else
  echo "tts: none — videos are silent with subtitles; no network at all (bin/setup --tts turns narration on)"
fi
echo "next: bin/doctor, then bin/claude"
