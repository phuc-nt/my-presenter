# Sourced by the wrappers in this folder: run_offline <program> [args…]
# runs it under the kit's offline profile:
# - macOS: sandbox-exec with offline.sb;
# - Linux, including WSL2: bubblewrap (bwrap), set up below.
# Without either, the tool refuses to run unless KIT_ALLOW_NO_PROFILE=1,
# because nothing would hold the network shut.
#
# A sandbox cannot always be nested. When the profile cannot be applied because
# this process already runs in Claude Code's sandbox (started by bin/claude,
# which closes the network itself), the program runs directly under that.
# Chrome may not start in there: for render, snapshot, check and shots the agent
# runs the tool outside the session sandbox, and this profile takes over.
kit_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"

# Linux: true when this process has no network interface but loopback, which is
# how Claude Code's sandbox (and this profile) leave it.
# The kernel adds its fallback tunnel devices (tunl0, gre0, sit0…) to every new
# namespace, always down; they are not a way out.
kit_net_isolated() {
  [ "$(awk -F: 'NR>2 { gsub(/ /, "", $1); if ($1 !~ /^(lo|tunl0|gre0|gretap0|erspan0|ip_vti0|ip6_vti0|sit0|ip6tnl0|ip6gre0)$/) n++ } END { print n+0 }' /proc/net/dev 2>/dev/null)" = 0 ]
}

# A temp dir of its own: the profile lets the tool reach unix sockets only here
# and in the repo, not those of other programs in /tmp. The path is short
# because a socket path may not exceed 104 bytes.
kit_make_tmp() {
  kit_tmp="$(cd "$(mktemp -d /tmp/kit.XXXXXX)" && pwd -P)"
  trap 'rm -rf "$kit_tmp"' EXIT
  export TMPDIR="$kit_tmp/"
}

kit_in_session() {
  [ -z "${KIT_DEBUG:-}" ] || echo "kit: already sandboxed, running directly" >&2
  rc=0; "$@" || rc=$?
  [ $rc -eq 0 ] || echo "kit: ${kit_tool:-the tool} ran inside the session sandbox, where Chrome may not start. If the error is about the browser, run the same command again as a command of its own (no cd, &&, or pipes) with the Bash sandbox disabled. That is pre-approved for ${kit_tool:-this tool}, which then runs under the kit's own offline profile: no network, writes only inside the repo." >&2
  exit $rc
}

kit_no_profile() {
  if [ "${KIT_ALLOW_NO_PROFILE:-}" = 1 ]; then exec "$@"; fi
  echo "kit: $1" >&2
  exit 1
}

# Linux profile. The tool sees the system read-only, and:
# - its own network namespace: loopback only, no DNS, no abstract sockets of
#   other programs;
# - fresh /tmp, /run and /mnt: no docker.sock, ssh or gpg agents, D-Bus, X11,
#   WSL interop socket (which starts Windows programs outside the profile) or
#   Windows drives;
# - an empty home, except the caches and tool installs listed below, read-only;
# - writes only to the repo and its temp dir; the kit's own code stays read-only.
kit_bwrap() {
  local a=(--die-with-parent --new-session --unshare-all
    --ro-bind / / --dev /dev --tmpfs /dev/shm --proc /proc)
  local d
  for d in /tmp /run /var/run /var/tmp /mnt /media; do
    [ -d "$d" ] && [ ! -L "$d" ] && a+=(--tmpfs "$d")
  done
  local home; home="$(cd "$HOME" 2>/dev/null && pwd -P)" || home=""
  if [ -n "$home" ] && [ "$home" != / ]; then
    a+=(--tmpfs "$home")
    local keep=(.cache/puppeteer .cache/hyperframes .nvm .volta .fnm .local/share/fnm .local/bin
      .local/share/fonts .fonts .config/fontconfig)
    local k t
    for k in "${keep[@]}"; do [ -e "$home/$k" ] && a+=(--ro-bind "$home/$k" "$home/$k"); done
    # Tools on PATH, and those the kit is pointed at, when they live in the home dir.
    local IFS=:
    for d in $PATH; do case "$d" in "$home"/*) [ -d "$d" ] && a+=(--ro-bind "$d" "$d") ;; esac; done
    unset IFS
    for t in node ffmpeg ffprobe whisper-cli "${HYPERFRAMES_BROWSER_PATH:-}" "${HYPERFRAMES_FFMPEG_PATH:-}" "${HYPERFRAMES_WHISPER_PATH:-}" "${HYPERFRAMES_WHISPER_MODEL:-}"; do
      [ -n "$t" ] || continue
      t="$(command -v "$t" 2>/dev/null || true)"; [ -n "$t" ] || continue
      t="$(readlink -f "$t")"
      case "$t" in "$home"/*) d="$(dirname "$(dirname "$t")")"; [ "$d" != "$home" ] && a+=(--ro-bind "$d" "$d") ;; esac
    done
  fi
  a+=(--bind "$kit_root" "$kit_root" --bind "$kit_tmp" "$kit_tmp")
  for d in bin tools vendor bundle .claude .kiro kit.config.json; do
    [ -e "$kit_root/$d" ] && a+=(--ro-bind "$kit_root/$d" "$kit_root/$d")
  done
  # A working directory outside the repo stays readable, so relative paths work.
  case "$PWD/" in "$kit_root"/*) ;; *) a+=(--ro-bind "$PWD" "$PWD") ;; esac
  a+=(--chdir "$PWD" --setenv TMPDIR "$kit_tmp/")
  rc=0; bwrap "${a[@]}" "$@" || rc=$?
  exit $rc
}

run_offline() {
  # A proxy on localhost would carry traffic past the profile.
  unset http_proxy https_proxy HTTP_PROXY HTTPS_PROXY all_proxy ALL_PROXY ftp_proxy FTP_PROXY no_proxy NO_PROXY
  case "$(uname -s)" in
    Darwin)
      command -v sandbox-exec >/dev/null || kit_no_profile "sandbox-exec not found; the offline profile cannot be applied. Set KIT_ALLOW_NO_PROFILE=1 to run without it." "$@"
      if sandbox-exec -p '(version 1)(allow default)' /usr/bin/true 2>/dev/null; then
        [ -z "${KIT_DEBUG:-}" ] || echo "kit: applying offline.sb" >&2
        kit_make_tmp
        rc=0; sandbox-exec -D ROOT="$kit_root" -D TMP="$kit_tmp" -f "$kit_root/bin/offline/offline.sb" "$@" || rc=$?
        exit $rc
      fi
      kit_in_session "$@" ;;
    Linux)
      if command -v bwrap >/dev/null && bwrap --unshare-all --ro-bind / / /bin/true 2>/dev/null; then
        [ -z "${KIT_DEBUG:-}" ] || echo "kit: applying the bwrap profile" >&2
        kit_make_tmp
        kit_bwrap "$@"
      fi
      kit_net_isolated && kit_in_session "$@"
      kit_no_profile "bubblewrap (bwrap) cannot create a sandbox here, so the offline profile cannot be applied. Install bubblewrap and see GUIDE.md. Set KIT_ALLOW_NO_PROFILE=1 to run without it." "$@" ;;
    *)
      kit_no_profile "no offline profile for $(uname -s); the kit runs on macOS and on Linux, including WSL2 on Windows. Set KIT_ALLOW_NO_PROFILE=1 to run without it." "$@" ;;
  esac
}
